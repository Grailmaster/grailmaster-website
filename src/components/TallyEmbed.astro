---
/**
 * Embeds a Tally.so form via Tally's standard iframe embed, click to load: nothing is requested
 * from Tally until the visitor presses "Show the form". The loader (Layout.astro, [data-consent-embed])
 * then inserts the iframe and loads Tally's widget script, which fills in the real src and resizes.
 *
 * Usage:
 *   <TallyEmbed formId="xX8XEr" title="Speaking Enquiry" height={1269} />
 *
 * `formId` is the short code from the embed URL Tally gives you
 * (https://tally.so/embed/<formId>...). `height` should match the
 * height Tally's own "Get the code" snippet gave you for this form —
 * dynamicHeight will adjust it after load, but starting close avoids
 * a layout jump.
 */
export interface Props {
  formId: string;
  title: string;
  height?: number;
  class?: string;
}

const { formId, title, height = 400, class: className = "w-full" } = Astro.props;

// transparentBackground restored: each form's text/answer colors are
// now set for a dark background directly in Tally's own Design panel,
// so the embed can blend into this site's dark cards again instead of
// showing its own light box.
const src = `https://tally.so/embed/${formId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;
---

{/* Click to load (privacy): the form comes from Tally (tally.so) only after the visitor asks for it. */}
<div data-consent-embed="tally" class={className}>
  <div data-consent-placeholder class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 text-sm text-[color:var(--text-muted)]">
    <p>This form is provided by Tally. Loading it connects your browser to tally.so (see <a href="/privacy" class="link-underline">Privacy</a>).</p>
    <button type="button" data-consent-load class="btn btn-primary mt-4">Show the form</button>
  </div>
  <template>
    <iframe
      data-tally-src={src}
      loading="lazy"
      width="100%"
      height={height}
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title={title}
      class="w-full"
    ></iframe>
  </template>
</div>
