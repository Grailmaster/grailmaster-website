---
import Layout from "../layouts/Layout.astro";
---

<Layout theme="lab" title="Privacy Policy | Grailmaster" description="Privacy policy and data protection information for grailmaster.com.">
  <section class="section">
    <div class="container-x max-w-2xl">
      <span class="eyebrow">Legal</span>
      <h1 class="mt-5 text-3xl font-semibold md:text-4xl">Privacy Policy</h1>
      <div class="mt-8 space-y-4 text-sm leading-relaxed text-[color:var(--text-muted)]">
        <p class="font-[family-name:var(--font-mono)] text-[0.72rem] text-[color:var(--text-dim)]">
          Placeholder — GDPR (DSGVO) requires a real privacy policy. Generate a tailored one (e.g. with a German Datenschutzerklärung generator) once your embeds are finalized.
        </p>
        <p>
          This site is hosted on Cloudflare Pages and uses third-party embedded services for
          forms and scheduling (e.g. Tally.so, Brevo, Cal.com). Each of these may process
          personal data you submit. List each processor, its purpose, and its own privacy
          policy here.
        </p>
        <p>
          <strong class="text-[color:var(--text)]">Data controller:</strong> Dr. Axel Schumacher,
          Munich, Germany — hello@grailmaster.com.
        </p>
        <p>
          You have the right to access, correct, and delete your personal data. Contact the
          address above to exercise these rights.
        </p>
      </div>
    </div>
  </section>
</Layout>
