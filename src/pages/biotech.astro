    }
  }

  /* ---------- THE THRESHOLD ---------------------------------------- */
  .threshold {
    background: var(--bg);
  }

  /* The art is a right-hand panel, not a full-bleed wash: the diagram is
     portrait, so covering the whole section would crop it to stripes. */
  .threshold__art {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(55%, 820px);
    z-index: 0;
    pointer-events: none;
  }

  .threshold__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
    opacity: 0.85;
  }

  /* Scrim: opaque where it meets the text column, clearing across the
     panel, and feathered top/bottom so the section melts into its
     neighbours instead of sitting in a box. */
  .threshold__art::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        var(--bg) 0%,
        var(--bg) 30%,
        color-mix(in srgb, var(--bg) 52%, transparent) 50%,
        color-mix(in srgb, var(--bg) 4%, transparent) 74%,
        color-mix(in srgb, var(--bg) 34%, transparent) 100%
      ),
      linear-gradient(
        to bottom,
        var(--bg) 0%,
        transparent 15%,
        transparent 85%,
        var(--bg) 100%
      );
  }

  .threshold__lead {
    font-size: clamp(1.55rem, 3.3vw, 2.6rem);
    line-height: 1.16;
    font-weight: 600;
    letter-spacing: -0.017em;
    text-wrap: balance;
  }

  /* Three key terms — the three faces of the transition. Lifted out of
     the body colour, not shouted. */
  .threshold__body strong {
    font-weight: 500;
    color: var(--text);
  }

  .threshold__close {
    border-left: 2px solid color-mix(in srgb, var(--accent) 65%, transparent);
    padding-left: 1.4rem;
  }

  .threshold__caption {
    margin-top: 4.5rem;
    max-width: 34rem;
    font-size: 0.76rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .threshold__kicker {
    margin-right: 0.7rem;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.85;
  }

  /* r is lower-case on purpose — it is the control parameter. */
  .threshold__eq {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.94em;
    color: color-mix(in srgb, var(--accent) 78%, var(--text));
    white-space: nowrap;
  }

  /* On narrow screens the art sits behind the copy, so it drops back
     and the scrim becomes a full-width veil. */
  /* Below this width the text column would run into the art panel, so
     the art drops behind the whole section as a faint veil instead. */
  @media (max-width: 1199px) {
    .threshold__art {
      width: 100%;
    }
    .threshold__art img {
      opacity: 0.3;
      object-position: 70% center;
    }
    .threshold__art::after {
      background: linear-gradient(
        to bottom,
        var(--bg) 0%,
        color-mix(in srgb, var(--bg) 66%, transparent) 18%,
        color-mix(in srgb, var(--bg) 66%, transparent) 82%,
        var(--bg) 100%
      );
    }
    .threshold__caption {
      margin-top: 3rem;
    }
  }
</style>
