/* ------------------------------------------------------------------
   Mortality comparison. Every comparator kills FEWER people per year
   than loneliness and yet has a dedicated global financing mechanism.
   That contrast — not the absolute number — is the argument.
   Sources: WHO Commission on Social Connection (30 June 2025);
   UNAIDS Global AIDS Update / fact sheet 2025 (2024 data);
   WHO World Malaria Report 2025 (2024 data);
   WHO, "Global status report on alcohol and drug use" (2019 data).
   ------------------------------------------------------------------ */
const MAXD = 871000;
const mortality = [
  {
    name: "Loneliness & social isolation",
    label: "871 000",
    deaths: 871000,
    year: "2025 est.",
    fund: "No fund. No agency. No budget line.",
    hl: true,
  },
  {
    name: "HIV / AIDS",
    label: "630 000",
    deaths: 630000,
    year: "2024",
    fund: "Global Fund · PEPFAR · UNAIDS",
    hl: false,
  },
  {
    name: "Malaria",
    label: "610 000",
    deaths: 610000,
    year: "2024",
    fund: "Global Fund · PMI · WHO Global Malaria Programme",
    hl: false,
  },
  {
    name: "Drug use disorders",
    label: "600 000",
    deaths: 600000,
    year: "2019",
    fund: "UNODC · national opioid strategies · treatment & harm reduction",
    hl: false,
  },
].map((m) => ({ ...m, pct: (m.deaths / MAXD) * 100 }));

