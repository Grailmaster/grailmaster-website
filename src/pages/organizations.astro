<style>
  /* ---------- HISTORIC PORTRAIT IN THE QUOTE BAND ----------
     The Cousins photograph is a small archive scan (300 × 399) and is
     warmer/flatter than the site's own photography. Framed square-on
     (no off-centre crop) and pulled very slightly towards the page
     palette so it sits inside the lab theme rather than on top of it.
     --------------------------------------------------------- */
  .portrait-hist img {
    object-position: 50% 26%;
    filter: saturate(0.88) contrast(1.04);
  }

  /* ---------- HERO BACKGROUND PHOTOGRAPH ----------
     public/images/photos/urban-loneliness-hero.webp
     Composition: lone figure left-of-centre, sociogram overlay bottom-right.
     The copy sits on the left, so the scrim is weighted left-to-right:
     opaque enough for AA text contrast over the figure, clearing to almost
     nothing over the sociogram on the right.
     ------------------------------------------------ */
  .hero-org {
    isolation: isolate;
    min-height: 800px;
    display: flex;
    align-items: center;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("/images/photos/urban-loneliness-hero.webp");
    background-size: cover;
    background-position: 50% 88%;
    background-repeat: no-repeat;
  }

  .hero-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      /* left-to-right legibility scrim — clears completely before the
         seated figure (image x ~63%) so he and the sociogram stay sharp */
      linear-gradient(
        100deg,
        var(--bg) 0%,
        color-mix(in srgb, var(--bg) 88%, transparent) 18%,
        color-mix(in srgb, var(--bg) 76%, transparent) 34%,
        color-mix(in srgb, var(--bg) 52%, transparent) 48%,
        color-mix(in srgb, var(--bg) 22%, transparent) 60%,
        transparent 72%
      ),
      /* top + bottom fade into the page */
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) 55%, transparent) 0%,
        transparent 18%,
        transparent 70%,
        color-mix(in srgb, var(--bg) 32%, transparent) 84%,
        color-mix(in srgb, var(--bg) 72%, transparent) 94%,
        var(--bg) 100%
      );
  }

  /* Tall/narrow viewports: photo becomes atmosphere only. */
  @media (max-width: 1023px) {
    .hero-org { min-height: 0; }
    .hero-photo { background-position: 70% 60%; }
    .hero-photo::after {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) 55%, transparent) 0%,
        color-mix(in srgb, var(--bg) 70%, transparent) 55%,
        var(--bg) 100%
      );
    }
  }

