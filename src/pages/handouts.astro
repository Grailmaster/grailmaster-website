---
import Layout from "../layouts/Layout.astro";
import { handouts } from "../data/handouts";
---

<Layout
  theme="podcast"
  title="Episode Handouts — Inside the Dating Mind"
  description="Every worksheet, guide, and homework handout from Inside the Dating Mind — free PDF downloads for all episodes."
>
  <section class="glow-top relative overflow-hidden border-b border-[color:var(--border)]">
    <div class="container-x relative z-10 py-20 md:py-24">
      <span class="eyebrow">Inside the Dating Mind</span>
      <h1 class="mt-6 max-w-3xl text-[clamp(2.2rem,5vw,3.4rem)] font-bold">
        The handout vault.
      </h1>
      <p class="lead mt-6 max-w-2xl text-lg">
        Every episode ships with homework — a worksheet, test, or guide that puts the science to
        work. All {handouts.length} of them live here, free to download.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <input
        type="search"
        id="handout-search"
        placeholder="Search by title or episode number…"
        class="w-full max-w-md rounded-[var(--radius)] border border-[color:var(--border-strong)] bg-[color:var(--surface)] px-5 py-3 text-sm text-[color:var(--text)] placeholder:text-[color:var(--text-dim)] focus:border-accent focus:outline-none"
      />

      <div id="handout-list" class="mt-8 flex flex-col divide-y divide-[color:var(--border)]">
        {
          handouts.map((h) => (
            <a
              href={h.url}
              target="_blank"
              rel="noopener"
              class="group flex items-baseline gap-5 py-5 transition-colors hover:bg-[color:var(--accent-soft)]"
              data-search={`${h.ep} ${String(h.ep).padStart(3, "0")} ${h.title.toLowerCase()}`}
            >
              <span class="w-16 shrink-0 font-[family-name:var(--font-mono)] text-[0.7rem] uppercase tracking-[0.14em] text-accent">
                Ep {String(h.ep).padStart(3, "0")}
              </span>
              <span class="flex-1 font-medium leading-snug group-hover:text-accent">{h.title}</span>
              <span class="hidden shrink-0 font-[family-name:var(--font-mono)] text-[0.66rem] uppercase tracking-[0.14em] text-[color:var(--text-dim)] sm:inline">
                PDF ↓
              </span>
            </a>
          ))
        }
      </div>
      <p id="no-results" class="mt-8 hidden text-[color:var(--text-muted)]">No handout matches that search.</p>

      <div class="card mt-12 flex flex-col items-center gap-4 p-8 text-center md:flex-row md:justify-between md:text-left">
        <div>
          <h3 class="text-xl font-semibold">Get every new handout automatically</h3>
          <p class="mt-1 text-sm text-[color:var(--text-muted)]">One email whenever an episode drops — handout included.</p>
        </div>
        <a href="/#join" class="btn btn-primary whitespace-nowrap">Join the list</a>
      </div>
    </div>
  </section>

  <script>
    const input = document.getElementById("handout-search") as HTMLInputElement;
    const rows = Array.from(document.querySelectorAll<HTMLElement>("#handout-list [data-search]"));
    const empty = document.getElementById("no-results")!;
    input?.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const hit = !q || (row.dataset.search ?? "").includes(q);
        row.style.display = hit ? "" : "none";
        if (hit) visible++;
      }
      empty.classList.toggle("hidden", visible > 0);
    });
  </script>
</Layout>
