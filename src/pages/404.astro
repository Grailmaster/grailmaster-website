---
import Layout from "../layouts/Layout.astro";
---

<Layout theme="lab" title="Not found | Grailmaster">
  <section class="section">
    <div class="container-x grid min-h-[50vh] place-items-center text-center">
      <div>
        <span class="eyebrow justify-center">404</span>
        <h1 class="mt-5 text-4xl font-bold md:text-6xl">Lost the signal.</h1>
        <p class="lead mx-auto mt-4 text-center">
          This page doesn't exist — or it moved when we unified the sites.
        </p>
        <a href="/" class="btn btn-primary mt-8">Back to home</a>
      </div>
    </div>
  </section>
</Layout>
