---
import Layout from "../layouts/Layout.astro";
---

<Layout theme="lab" title="Imprint (Impressum) | Grailmaster" description="Legal disclosure and imprint for grailmaster.com.">
  <section class="section">
    <div class="container-x max-w-2xl">
      <span class="eyebrow">Legal</span>
      <h1 class="mt-5 text-3xl font-semibold md:text-4xl">Imprint / Impressum</h1>
      <div class="mt-8 space-y-4 text-sm leading-relaxed text-[color:var(--text-muted)]">
        <p class="font-[family-name:var(--font-mono)] text-[0.72rem] text-[color:var(--text-dim)]">
          Placeholder — required in Germany under § 5 DDG (formerly § 5 TMG). Replace with your real details before launch.
        </p>
        <p>
          <strong class="text-[color:var(--text)]">Angaben gemäß § 5 DDG:</strong><br />
          Dr. Axel Schumacher<br />
          [Street address]<br />
          [Postal code] Munich, Germany
        </p>
        <p>
          <strong class="text-[color:var(--text)]">Contact:</strong><br />
          Email: hello@grailmaster.com<br />
          Phone: [optional]
        </p>
        <p>
          <strong class="text-[color:var(--text)]">Responsible for content (§ 18 Abs. 2 MStV):</strong><br />
          Dr. Axel Schumacher, address as above.
        </p>
      </div>
    </div>
  </section>
</Layout>
