---
import Layout from "../layouts/Layout.astro";
import BrevoForm from "../components/BrevoForm.astro";

const BREVO_ENDING_LONELINESS_LAUNCH =
  "https://b46562d2.sibforms.com/serve/MUIFAB1_toGNmK1lr-pCswviomD_TpoB_j7CJxAxSN9C_1gPRIwmpyUnd-uvSAaL1Hm7QmCAQKH_UOGj9MyaPIVsX3XqcStdRaowImPPABYu1JcQHedYWYVkeGmxtRWZRYujw-eW8qYmwjoQ4ia4gLlTD87PVuI9bwlowD6S-Cd1ip0E3cKtR9uzvTkEXkC_YUew92b8o33_HiL2Mw==";

const chapters = [
  "Why we stay lonely — the network trap",
  "The SCV: making connection measurable",
  "Reach, redundancy, richness",
  "Rebuilding a network from zero",
  "Weak ties and the longevity dividend",
  "A 90-day connection protocol",
];
---

<Layout
  theme="connection"
  title="Ending Loneliness — the book | Grailmaster"
  description="Ending Loneliness by Dr. Axel Schumacher — out 12 January 2027. Loneliness reframed as a solvable network problem, with the tools to solve it. Join the launch list."
>
  <section class="glow-top relative overflow-hidden border-b border-[color:var(--border)]">
    <div class="container-x relative z-10 grid gap-12 py-24 md:grid-cols-[1.1fr_0.9fr] md:items-center md:py-28">
      <div>
        <span class="eyebrow">The book · out <time datetime="2027-01-12">12 January 2027</time></span>
        <h1 class="mt-6 text-[clamp(2.3rem,5vw,4rem)] font-bold">Ending Loneliness</h1>
        <p class="mt-3 text-lg font-medium text-accent">A Sociogram Framework for Dating &amp; Relationship Coaches</p>
        <p class="lead mt-6 max-w-xl text-lg">
          Loneliness isn't a personality flaw or a life sentence. It's a network problem —
          and network problems have solutions. This is the science, and the method, for
          rebuilding a life full of connection.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#preorder" class="btn btn-primary">Join the launch list</a>
          <a href="/scv-framework" class="btn btn-ghost">The science behind it</a>
        </div>
      </div>

      <!-- Book cover -->
      <figure class="reveal mx-auto w-full max-w-sm">
        <div class="relative overflow-hidden rounded-xl border border-[color:var(--border)] shadow-2xl">
          <img
            src="/images/covers/ending-loneliness.webp"
            alt="Ending Loneliness — A Sociogram Framework for Dating & Relationship Coaches, by Dr. Axel Schumacher"
            width="880"
            height="1139"
            class="block w-full"
            fetchpriority="high"
          />
        </div>
        <figcaption class="mt-4 text-center font-[family-name:var(--font-mono)] text-[0.68rem] uppercase tracking-[0.18em] text-[color:var(--text-dim)]">
          Release · <time datetime="2027-01-12">12 January 2027</time>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 md:grid-cols-[0.85fr_1.15fr]">
      <div class="reveal">
        <span class="eyebrow">Inside</span>
        <h2 class="mt-5 text-3xl font-semibold">What you'll learn</h2>
      </div>
      <ol class="reveal space-y-px overflow-hidden rounded-2xl border border-[color:var(--border)]">
        {
          chapters.map((c, i) => (
            <li class="flex items-baseline gap-4 bg-[color:var(--surface)] p-5">
              <span class="font-[family-name:var(--font-mono)] text-sm text-accent">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="text-[color:var(--text)]">{c}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ===== THE APP ===== */}
  <section class="section border-t border-[color:var(--border)]" style="background:var(--bg-alt)">
    <div class="container-x">
      <div class="reveal max-w-2xl">
        <span class="eyebrow">The companion app · amoro.app</span>
        <h2 class="mt-5 text-3xl font-semibold">Read the method. Then run it.</h2>
        <p class="mt-5 leading-relaxed text-[color:var(--text-muted)]">
          Everything in these chapters — the map, the score, the 90-day protocol — is being built
          into <span class="text-[color:var(--text)]">Amoro</span>, an app that does the bookkeeping
          so you only have to do the living. Readers on the launch list get early access first.
        </p>
        <a href="/amoro" class="btn btn-ghost mt-7">See the app</a>
      </div>
    </div>
  </section>

  <section id="preorder" class="section border-t border-[color:var(--border)]">
    <div class="container-x">
      <div class="card glow-top relative overflow-hidden p-10 text-center md:p-16">
        <span class="eyebrow justify-center">Launch list</span>
        <h2 class="mx-auto mt-5 max-w-2xl text-3xl font-semibold md:text-4xl">
          Out <time datetime="2027-01-12">12 January 2027</time>
        </h2>
        <p class="lead mx-auto mt-4 text-center">
          Join the list for a free chapter before release day and the launch-week bonuses.
        </p>
        <BrevoForm
          action={BREVO_ENDING_LONELINESS_LAUNCH}
          buttonLabel="Notify me"
          successText="You're on the launch list — we'll email you on launch day."
        />
      </div>
    </div>
  </section>
</Layout>
