---
import Layout from "../layouts/Layout.astro";
import TallyEmbed from "../components/TallyEmbed.astro";

const signals = [
  "Your week is work and errands — almost no recurring social settings.",
  "You know a lot of people, yet nobody ever introduces you to someone suitable.",
  "Most of your contacts are locked inside one context, and they don't overlap.",
  "Everyone you meet is already partnered — or clearly not a fit for you.",
  "You are stuck in the friend zone, or keep landing back in it, with no route out.",
  "Dating apps either don't work for you, or give you exposure without belonging.",
  "After a move, a divorce, or years of career focus, your network no longer supports the life you want.",
];

const steps = [
  { t: "Map", d: "We build a sociogram of the real people, groups, and recurring environments in your life." },
  { t: "Diagnose", d: "We find the actual bottleneck — too few ties, no repetition, isolated clusters, or missing bridges." },
  { t: "Design", d: "A small number of high-leverage changes that fit your personality, your city, and your time." },
  { t: "Act", d: "Create repeated contact, deepen selected ties, reopen dormant ones, enter compatible circles." },
  { t: "Adapt", d: "Review what moved, where friction remains, and what to change next." },
];

const breadth = [
  "First-date structure and conversation",
  "Flirting and calibrated escalation",
  "Sexual polarity and attraction dynamics",
  "Profile and photo selection",
  "Reading interest and disinterest accurately",
  "Long-term relationship maintenance",
];

const faqs = [
  {
    q: "Is this dating coaching?",
    a: "<p>Partly — but it starts earlier than most. Before we talk about dates, we look at whether your life produces enough repeated, trusted contact for a relationship to become likely at all. If your bottleneck really is first dates or flirting, we work on that directly. Often it isn't.</p>",
  },
  {
    q: "Do I have to be an extrovert?",
    a: "<p>No. The method is built around fit and repetition, not volume. Most clients do better with two well-chosen recurring settings than with fifty new introductions.</p>",
  },
  {
    q: "Is this therapy?",
    a: "<p>No. I am not a licensed psychologist or psychotherapist and I do not provide clinical treatment. Coaching addresses goals, behaviour, and social structure. If something falls outside that scope, I will say so and point you toward appropriate professional support.</p>",
  },
  {
    q: "Do you guarantee I will find a partner?",
    a: "<p>No — and be sceptical of anyone who does, because nobody can guarantee another person's choices. What the work improves are the conditions, behaviours, and opportunities that are genuinely within your influence.</p>",
  },
  {
    q: "How is my sociogram protected?",
    a: "<p>A sociogram contains information about people who are not my clients, so I collect the minimum necessary. Third parties can be entered as initials or pseudonyms. Before any intake you receive a plain-language note on what is stored, for how long, and how to have it deleted.</p><p>I also work with well-known individuals. Confidentiality is absolute.</p>",
  },
  {
    q: "Which languages, and which time zone?",
    a: "<p>Sessions run in English or German, by secure video call. Scheduling is in Central European Time (CET).</p>",
  },
  {
    q: "How do I book, and how do I pay?",
    a: "<p>Start with the enquiry form below. You'll hear back within 24 hours with available slots. Payment by IBAN bank transfer (EU), PayPal, or Wise (international); the session is confirmed once payment is received. Credit cards are not currently accepted.</p>",
  },
  {
    q: "What if I need to cancel or reschedule?",
    a: "<p>You may reschedule once per booking without penalty if you give at least 48 hours' notice.</p><ul><li>First late cancellation or no-show (under 48 hours): 50% of the fee is retained.</li><li>Second late cancellation or no-show: 100% is retained.</li></ul>",
  },
  {
    q: "Can I ask for a reduced rate?",
    a: "<p>Usually not — but a limited number of subsidised places are available each month through the Connection Scholarship, for people in genuine financial need. Apply through the enquiry form and describe your circumstances.</p>",
  },
];
---

<Layout
  theme="connection"
  title="Sociogram Coaching for Singles | Dr. Axel Schumacher"
  description="Map the social structure behind loneliness and dating frustration. One-to-one sociogram-based coaching with Dr. Axel Schumacher — Munich and online."
>
  {/* ===== HERO ===== */}
  <section class="glow-top relative overflow-hidden border-b border-[color:var(--border)]">
    <div class="container-x relative z-10 py-24 md:py-28">
      <div class="hero-split">
        <div>
          <span class="eyebrow">Coaching for individuals</span>
          <h1 class="mt-6 text-[clamp(2.3rem,5vw,4rem)] font-bold">
            Loneliness is not a personality flaw. It is almost always a structure problem.
          </h1>
          <p class="lead mt-7 text-lg">
            If your daily life does not regularly bring you into repeated, trusted encounters with people where you are truly seen, felt as safe, and where they are slowly drawn toward you, then no amount of sharper dating app photos, flirting skills, or clever openers will ever be enough.
          </p>
          <p class="mt-5 leading-relaxed text-[color:var(--text-muted)]">
            You don’t need more superficial matches. You need a functioning relational ecosystem where finding love and connection becomes highly probable. I help you map your current social world with clarity and precision, reveal exactly where the natural flow of connection breaks down, and then rebuild it — intelligently, deliberately, and beautifully. Together, we grow your “social connectome”, where deep, lasting partnership, love, and connection become the most natural outcome.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offers" class="btn btn-primary">Audit my network</a>
            <a href="#method" class="btn btn-ghost">How the method works</a>
          </div>
          <div class="mt-10">
            <span class="eyebrow">What we work toward</span>
            <div class="pill-row">
              <span class="pill">Find lasting love</span>
              <span class="pill">End loneliness</span>
              <span class="pill">Exit one-sided relationships</span>
              <span class="pill">Turn acquaintances into real friendships</span>
              <span class="pill">Rebuild after divorce or relocation</span>
            </div>
            <p class="mt-5 text-[0.78rem] leading-relaxed text-[color:var(--text-muted)]">
              Munich and online · English or German · Science-informed, no pickup tactics · Coaching, not psychotherapy
            </p>
          </div>
        </div>
        <div class="hero-figure reveal">
          <img
            src="/images/photos/conference.png"
            alt="Dr. Axel Schumacher before a talk"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ===== RECOGNITION ===== */}
  <section class="section signals-band">
    <div class="signals-band__bg" style="background-image:url(/images/photos/group-table.png)" aria-hidden="true"></div>
    <div class="signals-band__scrim" aria-hidden="true"></div>
    <div class="container-x grid gap-12 md:grid-cols-[0.85fr_1.15fr]">
      <div class="reveal">
        <span class="eyebrow">You may not need more dating advice</span>
        <h2 class="mt-5 text-3xl font-semibold md:text-4xl">
          You may need more places where the right people can meet you twice.
        </h2>
        <figure class="signals-photo">
          <img
            src="/images/photos/couplea.webp"
            alt="A couple sitting close together on a sofa in evening light, her head resting against his shoulder"
            width="1000"
            height="563"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
      <div class="reveal">
        <p class="leading-relaxed text-[color:var(--text-muted)]">
          Attraction needs repetition to become trust, and trust needs bridges to become
          opportunity. Most dating advice optimises the surface of a system that isn't producing
          enough encounters to work with. See whether any of this sounds like your week:
        </p>
        <ul class="mt-6 space-y-4">
          {
            signals.map((s) => (
              <li class="flex gap-3 leading-relaxed text-[color:var(--text-muted)]">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                <span>{s}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ===== METHOD ===== */}
  <section id="method" class="section border-t border-[color:var(--border)]">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">The Sociogram Method</span>
        <h2 class="mt-5 text-3xl font-semibold md:text-4xl">
          Dating outcomes emerge from a healthy “social connectome”. We make that system visible &amp; actionable.
        </h2>
        <p class="lead mt-6">
          Confidence and communication matter deeply — but they can only flourish inside a healthy opportunity structure: the people who populate your life, the frequency and quality of your encounters, the slow accumulation of trust, and the natural pathways that connect you to new, aligned souls.
        </p>
        <p class="mt-5 leading-relaxed text-[color:var(--text-muted)]">
          When this structure is weak or fragmented, even the most attractive presence struggles to create lasting connection. When it is rich and alive, connection flows more naturally, and the right people find their way to you with far less effort.
        </p>
      </div>

      <div class="flow">
        {
          steps.map((s, i) => (
            <div class="flow__step">
              <span class="flow__num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))
        }
      </div>

      <div class="scv-panel">
        <div class="reveal">
          <span class="eyebrow">The number behind the plan</span>
          <h3 class="mt-5 text-2xl font-semibold md:text-3xl">Your Social Connectivity Value.</h3>
          <p class="mt-5 leading-relaxed text-[color:var(--text-muted)]">
            The SCV is a single number distilled from your sociogram. Every relationship in your map
            contributes to it, scored on three questions:
          </p>
          <div class="scv-inputs">
            <div class="scv-input"><b>Valence</b><span>Does this relationship nourish you, or drain you?</span></div>
            <div class="scv-input"><b>Dose</b><span>How often, and how intensely, does real contact happen?</span></div>
            <div class="scv-input"><b>Consequence</b><span>Does this tie steady your physiology — or unsettle it?</span></div>
          </div>
          <p class="mt-6 leading-relaxed text-[color:var(--text-muted)]">
            Because the SCV moves the moment your network does, it can be tracked like blood pressure.
            That is what separates this from advice: at week twelve we can see whether the structure
            actually changed, instead of asking whether you feel better.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-[color:var(--text-muted)]">
            It is not a happiness score, and it cannot tell you whether one particular person is right
            for you. It measures the structure around you, nothing more.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/scv-framework" class="btn btn-ghost text-sm">Read the peer-reviewed framework</a>
          </div>
        </div>

        <figure class="scv-figure reveal">
          <svg viewBox="0 0 720 300" role="img" aria-label="A chart showing the Social Connectivity Value rising from the isolated range to the thriving range over twelve weeks of coaching.">
            <rect x="60" y="196" width="632" height="60" fill="currentColor" opacity="0.05" />
            <rect x="60" y="44" width="632" height="70" fill="var(--accent)" opacity="0.07" />
            <line x1="60" y1="256" x2="692" y2="256" stroke="var(--border-strong)" stroke-width="1" />
            <line x1="60" y1="44" x2="60" y2="256" stroke="var(--border-strong)" stroke-width="1" />
            <line x1="60" y1="150" x2="692" y2="150" stroke="var(--border)" stroke-width="1" stroke-dasharray="3 5" />
            <text x="68" y="66" font-size="11" font-family="var(--font-mono)" fill="var(--text-muted)">THRIVING</text>
            <text x="68" y="240" font-size="11" font-family="var(--font-mono)" fill="var(--text-muted)">ISOLATED</text>
            <text x="68" y="145" font-size="11" font-family="var(--font-mono)" fill="var(--text-muted)">BASELINE</text>
            <line x1="196" y1="44" x2="196" y2="256" stroke="var(--accent)" stroke-width="1" stroke-dasharray="4 4" opacity="0.7" />
            <circle cx="196" cy="212" r="4.5" fill="var(--surface)" stroke="var(--accent)" stroke-width="2" />
            <text x="204" y="86" font-size="12" font-family="var(--font-mono)" fill="var(--accent)">SOCIOGRAM AUDIT</text>
            <path d="M70,206 C110,214 150,213 196,212 C240,211 268,198 300,182 C338,163 372,140 412,124 C452,108 492,96 534,86 C578,76 630,68 686,62"
                  fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
            <circle cx="686" cy="62" r="5" fill="var(--accent)" />
            <text x="60" y="278" font-size="11" font-family="var(--font-mono)" fill="var(--text-muted)">WEEK 0</text>
            <text x="330" y="278" font-size="11" font-family="var(--font-mono)" fill="var(--text-muted)">WEEK 6</text>
            <text x="638" y="278" font-size="11" font-family="var(--font-mono)" fill="var(--text-muted)">WEEK 12</text>
          </svg>
          <figcaption>
            An illustrative SCV trajectory. The Audit establishes the baseline; the curve reflects
            structural change — recurring settings joined, dormant ties reactivated, bridges built.
            Individual trajectories vary, and some go sideways before they rise.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ===== OFFERS ===== */}
  <section id="offers" class="section border-t border-[color:var(--border)]">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Ways we can work together</span>
        <h2 class="mt-5 text-3xl font-semibold md:text-4xl">
          Stop wasting time on surface fixes. Your path out of loneliness is a structural choice.
        </h2>
        <p class="lead mt-6">
          Every engagement is strictly one-to-one, completely private, and conducted via secure video call. Because every social network is unique, every option begins with a confidential pre-session intake and a comprehensive, structural mapping of your current relationship ecosystem.
        </p>
      </div>

      <div class="offer-grid"><div class="offer"><div><h3 class="offer__name">The Connectome Rebuild</h3><p class="offer__promise">A six-month guided evolution to rebuild the world around you from the ground up.</p><p class="offer__price">€2,250 <span class="offer__usd">/ $2,425</span></p><p class="offer__note">180-day intensive engagement. Begins with a fit call to confirm alignment.</p><a href="#book" class="btn btn-ghost">Request a fit call</a></div><ul class="offer__list"><li><b>Ten dedicated strategy sessions</b> — scheduled dynamically as your real-world network evolves.</li><li><b>Iterative sociogram modelling</b> — your network model is continuously updated and recalibrated as you activate new social nodes.</li><li><b>Field deployment and accountability</b> — structured real-world steps between sessions to safely expand your repeated, trusted encounters.</li><li><b>The communication toolkit</b> — scripts and templates for high-impact invitations, low-friction reconnections, and natural introductions.</li><li><b>Ongoing research and optimisation</b> — continuing tailored research into the social opportunities available in your specific environment.</li><li><b>Real-time support</b> — direct WhatsApp, text, and email access for guidance before events and critical interactions.</li></ul></div><div class="offer offer--featured"><span class="offer__tag">Most chosen</span><div><h3 class="offer__name">The Social Ecosystem Blueprint</h3><p class="offer__promise">A precision plan for a life where love can actually flourish.</p><p class="offer__price">€799 <span class="offer__usd">/ $865</span></p><p class="offer__note">Scheduled flexibly. Includes your comprehensive custom protocol.</p><a href="#book" class="btn btn-primary">Book the Blueprint</a></div><ul class="offer__list"><li>Everything included in the Sociogram Audit (see below)</li><li><b>Three 60-minute sessions</b> (or six 30-minute sessions), scheduled to fit your life.</li><li><b>Historical mapping and behavioural analysis</b> — an audit of your past relationship and social patterns, to isolate psychological and environmental friction points.</li><li><b>The interpersonal blueprint</b> — focused work on social mechanics where internal barriers, not structure, are the primary bottleneck.</li><li><b>A written action protocol</b> — your tailored, step-by-step plan, delivered within 48 hours.</li><li><b>Priority strategy support</b> — direct email access to refine your approach for 90 days.</li></ul></div><div class="offer"><div><h3 class="offer__name">The Sociogram Audit</h3><p class="offer__promise">Find and fix the hidden friction points in your current social architecture.</p><p class="offer__price">€199 <span class="offer__usd">/ $215</span></p><p class="offer__note">Entry diagnostic — for absolute clarity before committing to structural change.</p><a href="#book" class="btn btn-ghost">Book the Audit</a></div><ul class="offer__list"><li><b>Confidential intake and pre-mapping</b> — your sociogram is built before we meet.</li><li><b>60-minute diagnostic consultation</b> — a data-driven dissection of your week.</li><li><b>Bottleneck isolation</b> — the exact structural point where your flow of connection breaks down.</li><li><b>Your connection architecture blueprint</b> — a one-page visual map of your current relational ecosystem.</li><li><b>90-day action sequence</b> — clear tactical priorities drawn from dating and network-science analysis.</li></ul></div></div>

      <div class="assurance reveal">
        <span class="assurance__mark" aria-hidden="true"><svg viewBox="0 0 30 30" fill="none"><circle cx="15" cy="15" r="13" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.1" stroke-dasharray="2 3"></circle><circle cx="15" cy="15" r="8.5" stroke="currentColor" stroke-opacity="0.7" stroke-width="1.1"></circle><circle cx="15" cy="15" r="4" stroke="currentColor" stroke-width="1.2"></circle><circle cx="15" cy="15" r="2" fill="currentColor"></circle><circle cx="23.5" cy="15" r="1.5" fill="currentColor"></circle><circle cx="9" cy="7.5" r="1.3" fill="currentColor"></circle></svg></span>
        <div>
          <p>Every program is designed and delivered directly by <b>the creator of the Sociogram Method</b> — a rigorous system built on network and behavioural science, engineered to fix the structural bottlenecks that generic dating advice ignores entirely.</p>
        </div>
      </div>

      <div class="exclusions reveal">
        <h3>Who this is not for</h3>
        <p class="exclusions__intro">
          I run an ethics-first practice grounded in dating and network science, and in real-world execution. To protect the integrity of the method — and the results of the clients already doing the work — I respectfully decline enquiries seeking:
        </p>
        <ul class="exclusions__list">
          <li><b>Quick-fix “pickup” tactics or manipulation</b>We engineer genuine, high-trust social ecosystems — not artificial or cringey pickup scripts.</li>
          <li><b>Passive “magic pills”</b>The sociogram gives you a precise blueprint, but you must be willing to do the real-world work that activates your network.</li>
          <li><b>Validation over transformation</b>This process is built for people ready to build, adapt, and move forward — not for endless venting without action.</li>
          <li><b>Deep-seated cynicism</b>If you believe human connection or modern dating is inherently hopeless, or that “all men” or “all women” are terrible, this structured, optimistic process will not fit.</li>
          <li><b>Third-party monitoring or clinical therapy</b>I do not help anyone track an ex-partner, and this is not a substitute for clinical mental-health treatment.</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ===== BREADTH ===== */}
  <section class="section border-t border-[color:var(--border)]">
    <div class="container-x grid gap-12 md:grid-cols-2 md:items-center">
      <div class="reveal">
        <span class="eyebrow">Once the structure works</span>
        <h2 class="mt-5 text-3xl font-semibold md:text-4xl">
          The sociogram gets you in the room. What happens there still matters.
        </h2>
        <p class="mt-6 leading-relaxed text-[color:var(--text-muted)]">
          Structure is where I start because it's the layer almost everyone ignores — but it isn't
          the whole problem. Forty years of fieldwork, 1,500+ books, and work alongside some of the
          best coaches alive sit behind the interpersonal side, and we use it whenever that's where
          you're actually stuck.
        </p>
        <ul class="offer__list">
          {breadth.map((b) => <li>{b}</li>)}
        </ul>
      </div>
      <figure class="section-figure reveal">
        <img
          src="/images/photos/cave-1.png"
          alt="Dr. Axel Schumacher working with a small group around a table"
          loading="lazy"
        />
        <figcaption>
          Structure becomes real in rooms like this one — repeated contact, in a setting that fits.
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ===== THE APP ===== */}
  <section class="section border-t border-[color:var(--border)]" style="background:var(--bg-alt)">
    <div class="container-x">
      <div class="card glow-top relative overflow-hidden p-8 reveal md:p-12">
        <div class="grid gap-10 md:grid-cols-[1.15fr_0.85fr] md:items-center">
          <div>
            <span class="eyebrow">Between the sessions · be:moyo</span>
            <h2 class="mt-5 text-3xl font-semibold md:text-4xl">
              The method, running in the background.
            </h2>
            <p class="mt-6 leading-relaxed text-[color:var(--text-muted)]">
              Our sessions are where the map gets drawn and the hard decisions get made.
              <span class="text-[color:var(--text)]">be:moyo</span> is what keeps it alive on the other
              twenty-nine days of the month: your sociogram on your phone, your SCV updating as your
              world actually changes, and a short list of moves each week — so momentum stops
              depending on whether you remembered.
            </p>
            <p class="mt-4 leading-relaxed text-[color:var(--text-muted)]">
              It is in development now, and coaching clients get in first.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/be-moyo/" class="btn btn-primary">See be:moyo</a>
              <a href="/be-moyo/#waitlist" class="btn btn-ghost">Join the waitlist</a>
            </div>
          </div>
          <div>
            <figure class="app-photo">
              <img
                src="/images/photos/coupleb.webp"
                alt="A couple sitting close together in a café, with the be:moyo sociogram and its scored nodes drawn over the scene"
                width="1000"
                height="563"
                loading="lazy"
                decoding="async"
              />
              <figcaption>Your sociogram, laid over the life it is actually describing.</figcaption>
            </figure>
            <ul class="mt-8 space-y-4 text-sm leading-relaxed text-[color:var(--text-muted)]">
            <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span><b class="text-[color:var(--text)]">Your map, live.</b> The sociogram we build together, kept current instead of frozen at the date we drew it.</span></li>
            <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span><b class="text-[color:var(--text)]">The weekly move.</b> One small, specific action chosen for your structure — not a motivational quote.</span></li>
            <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span><b class="text-[color:var(--text)]">A score that moves.</b> Progress you can see between sessions, so we spend our hour on the hard part.</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== BOUNDARY ===== */}
  <section class="section border-t border-[color:var(--border)]">
    <div class="container-x">
      <div class="card glow-top relative overflow-hidden p-10 text-center md:p-14">
        <h2 class="mx-auto max-w-3xl text-3xl font-semibold md:text-4xl">
          Discover the quiet confidence, ease, and delight of dating as your authentic self.
        </h2>
        <p class="lead mx-auto mt-5 text-center">
          Practical, science-informed coaching that cuts through the noise and overthinking — so
          real connection can grow&nbsp;naturally.
        </p>
        <p class="boundary-coda">
          No pickup lines. No manipulation. No manifesting. Just grounded clarity.
        </p>
      </div>
    </div>
  </section>

  {/* ===== FAQ ===== */}
  <section class="section border-t border-[color:var(--border)]">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Before you book</span>
        <h2 class="mt-5 text-3xl font-semibold md:text-4xl">Questions people ask first.</h2>
      </div>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="faq__a" set:html={f.a} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===== BOOKING ===== */}
  <section id="book" class="section border-t border-[color:var(--border)]">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Book</span>
        <h2 class="mt-5 text-3xl font-semibold md:text-4xl">Tell me what you're working with.</h2>
        <p class="lead mt-6">
          A short, confidential enquiry — what your situation looks like and what you want to
          change. I read every one personally and get back to you as soon as I can, with next
          steps and a time to talk.
        </p>
      </div>

      <div class="card mt-10 p-8 md:p-12">
        <TallyEmbed formId="BzJEg1" title="Dating Coaching Enquiry" height={980} />
      </div>

      <div class="note-box">
