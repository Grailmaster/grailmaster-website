---
import "../styles/fonts.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description?: string;
  /** Visual world for this page: "lab" (science), "connection" (human), or "podcast" (Inside the Dating Mind). */
  theme?: "lab" | "connection" | "podcast";
  image?: string;
  /** Hide this page from search engines (used for unlisted pages such as /courses). */
  noindex?: boolean;
}

const {
  title,
  description = "Optimizing the human lifespan through biology, network science, and deep connection. The work of Dr. Axel Schumacher — geneticist, longevity scientist, and founder.",
  theme = "lab",
  image = "/og-default.png",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content="Grailmaster" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Fonts are self-hosted (src/styles/fonts.css, public/fonts/): no request to Google (GDPR, LG München I 3 O 17493/20) -->
    <link rel="preload" href="/fonts/inter-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-[color:var(--accent-contrast)]"
      >Skip to content</a
    >
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Site-wide contact address, assembled at runtime so the raw
        "user@domain" string never sits in the static HTML for scrapers
        to regex. Any element with [data-site-mail] gets its real
        mailto: href written in on load; add [data-site-mail-text] to
        also swap its visible text to the real address once JS runs.
        Without JS, visitors still see a readable "user [at] domain"
        fallback in the markup — not a dead link, just not machine-
        parseable as an address. Same idea as the Aerion contact block
        on /biotech, generalized site-wide under a different data
        attribute so the two never collide. */}
    <script is:inline>
      (function () {
        var SITE_MAIL_USER = "parallelspace.advisors";
        var SITE_MAIL_DOMAIN = "gmail.com";
        document.querySelectorAll("[data-site-mail]").forEach(function (el) {
          var u = el.dataset.mailUser || SITE_MAIL_USER;
          var d = el.dataset.mailDomain || SITE_MAIL_DOMAIN;
          var a = u + String.fromCharCode(64) + d;
          var q = [];
          if (el.dataset.subject) q.push("subject=" + encodeURIComponent(el.dataset.subject));
          if (el.dataset.body) q.push("body=" + encodeURIComponent(el.dataset.body));
          el.setAttribute("href", "mailto:" + a + (q.length ? "?" + q.join("&") : ""));
          if (el.hasAttribute("data-site-mail-text")) el.textContent = a;
        });
      })();
    </script>

    {/* Brevo signup forms: any <form data-brevo-form data-action="..."> on
        the page submits here via a background fetch instead of a real page
        navigation, so the visitor never leaves the site or sees Brevo's own
        page. A hidden honeypot field (email_address_check) silently drops
        obvious bots. On success the form is swapped for a short confirmation
        line; on network failure the button re-enables so they can retry. */}
    <script is:inline>
      (function () {
        document.querySelectorAll("[data-brevo-form]").forEach(function (form) {
          form.addEventListener("submit", function (e) {
            e.preventDefault();
            var honeypot = form.querySelector('[name="email_address_check"]');
            if (honeypot && honeypot.value) return;
            var emailField = form.querySelector('[name="EMAIL"]');
            var btn = form.querySelector('[type="submit"]');
            var originalLabel = btn ? btn.textContent : "";
            if (btn) {
              btn.disabled = true;
              btn.textContent = "…";
            }
            var body = new URLSearchParams();
            body.set("EMAIL", emailField ? emailField.value : "");
            body.set("email_address_check", "");
            body.set("locale", "en");
            body.set("html_type", "simple");
            fetch(form.dataset.action, { method: "POST", mode: "no-cors", body: body })
              .then(function () {
                var success = document.createElement("p");
                success.className = "text-sm font-medium text-[color:var(--text)]";
                success.textContent = form.dataset.successText || "You're on the list.";
                form.replaceWith(success);
              })
              .catch(function () {
                if (btn) {
                  btn.disabled = false;
                  btn.textContent = originalLabel;
                }
                var err = form.parentElement && form.parentElement.querySelector("[data-brevo-error]");
                if (err) err.classList.remove("hidden");
              });
          });
        });
      })();
    </script>

    {/* Click-to-load embeds (privacy): nothing is requested from Tally or YouTube until the visitor
        presses the button in a [data-consent-embed] box (TallyEmbed.astro, the podcast page's video).
        Then the box's <template> content is inserted; for Tally its widget script is loaded once, which
        fills in iframe[data-tally-src] and handles auto-resizing. */}
    <script is:inline>
      (function () {
        function tally() {
        var d = document,
          w = "https://tally.so/widgets/embed.js",
          v = function () {
            if (typeof Tally !== "undefined") {
              Tally.loadEmbeds();
            } else {
              d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(function (e) {
                e.src = e.dataset.tallySrc;
              });
            }
          };
        if (typeof Tally !== "undefined") {
          v();
        } else if (d.querySelector('script[src="' + w + '"]') == null) {
          var s = d.createElement("script");
          s.src = w;
          s.onload = v;
          s.onerror = v;
          d.body.appendChild(s);
        }
        }
        document.querySelectorAll("[data-consent-embed]").forEach(function (box) {
          var btn = box.querySelector("[data-consent-load]");
          var tpl = box.querySelector("template");
          if (!btn || !tpl) return;
          btn.addEventListener("click", function () {
            var holder = box.querySelector("[data-consent-placeholder]");
            box.appendChild(tpl.content.cloneNode(true));
            if (holder) holder.remove();
            if (box.dataset.consentEmbed === "tally") tally();
            var frame = box.querySelector("iframe");
            if (frame) frame.focus();
          });
        });
      })();
    </script>

    <!-- Progressive reveal-on-scroll; content is fully visible without JS -->
    <script>
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
